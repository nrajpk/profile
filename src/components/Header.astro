---
import { nav, contact, skins } from '../data/site.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => path === href || path.startsWith(href + '/');
---

<header class="fixed top-0 inset-x-0 z-50 bg-paper/85 backdrop-blur-md border-b border-stone-200/70">
  <div class="max-w-7xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between gap-6">
    <div class="flex items-center gap-6">
      <a href="/" class="font-bold text-lg tracking-tight text-stone-900 group" aria-label="nrajpk — home">
        nrajpk<span class="text-zapier inline-block group-hover:translate-x-1 transition-transform duration-500">_</span>
      </a>
      <div class="hidden xl:flex items-center gap-2 text-[11px] font-medium text-stone-500">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        {contact.location}
      </div>
    </div>

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {nav.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'relative text-[13px] font-medium transition-colors group py-2',
            isActive(link.href) ? 'text-zapier' : 'text-stone-500 hover:text-stone-900',
          ]}
        >
          {link.name}
          <span
            class:list={[
              'absolute bottom-0.5 left-0 h-px bg-zapier transition-all duration-500',
              isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full',
            ]}
          ></span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <div class="hidden sm:flex items-center gap-1 p-1 rounded-full border border-stone-200" role="group" aria-label="Page skin">
        {skins.map((skin) => (
          <button
            type="button"
            data-skin-set={skin.id}
            aria-pressed="false"
            title={`${skin.name} skin`}
            class="skin-dot h-5 w-5 rounded-full border border-stone-300 transition-transform duration-300 hover:scale-110"
            style={`background:${skin.swatch}`}
          >
            <span class="sr-only">{skin.name} skin</span>
          </button>
        ))}
      </div>

      <button
        type="button"
        data-palette-open
        class="hidden lg:inline-flex items-center gap-2 h-8 px-3 rounded-full border border-stone-200 text-[11px] font-medium text-stone-500 hover:text-stone-900 hover:border-stone-400 transition-colors"
      >
        Jump to
        <kbd class="font-mono text-[10px] text-stone-400">⌘K</kbd>
      </button>

      <a
        href={`mailto:${contact.email}`}
        class="hidden sm:inline-flex items-center h-9 px-5 rounded-full bg-stone-900 text-white text-[12px] font-semibold hover:bg-zapier transition-colors active:scale-95"
      >
        Connect
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden relative h-10 w-10 -mr-2 flex items-center justify-center"
      >
        <span class="sr-only">Menu</span>
        <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="md:hidden fixed inset-0 top-16 z-40 bg-paper overflow-y-auto" hidden>
  <nav class="px-5 pt-8 pb-10 flex flex-col min-h-full" aria-label="Mobile">
    <ul class="flex-1">
      {[{ name: 'Home', href: '/', note: 'Start here' }, ...nav].map((link, i) => (
        <li class="menu-item border-b border-stone-200" style={`--i:${i}`}>
          <a
            href={link.href}
            aria-current={(link.href === '/' ? path === '/' : isActive(link.href)) ? 'page' : undefined}
            class="flex items-baseline justify-between gap-4 py-4 aria-[current=page]:text-zapier"
          >
            <span class="font-serif text-4xl leading-none">{link.name}</span>
            <span class="text-xs text-stone-500 text-right">{link.note}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="pt-8 flex flex-col gap-5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Skin</span>
        <div class="flex items-center gap-2" role="group" aria-label="Page skin">
          {skins.map((skin) => (
            <button
              type="button"
              data-skin-set={skin.id}
              aria-pressed="false"
              class="skin-chip h-9 px-4 rounded-full border border-stone-300 text-xs font-semibold"
            >
              {skin.name}
            </button>
          ))}
        </div>
      </div>
      <div class="flex gap-3">
        <a href={`mailto:${contact.email}`} class="flex-1 h-12 rounded-full bg-stone-900 text-white text-sm font-semibold flex items-center justify-center">Email me</a>
        <a href={contact.linkedin} target="_blank" rel="noreferrer" class="flex-1 h-12 rounded-full border border-stone-300 text-sm font-semibold flex items-center justify-center">LinkedIn</a>
      </div>
    </div>
  </nav>
</div>

<style>
  .skin-dot[aria-pressed="true"] { outline: 2px solid var(--color-zapier); outline-offset: 2px; }
  .skin-chip[aria-pressed="true"] { background: var(--color-zapier); border-color: var(--color-zapier); color: #fff; }

  .menu-bars { position: relative; width: 22px; height: 10px; display: block; }
  .menu-bars i {
    position: absolute; left: 0; width: 100%; height: 1.5px; background: var(--color-stone-900);
    transition: transform 0.5s var(--ease-out-expo), top 0.5s var(--ease-out-expo);
  }
  .menu-bars i:first-child { top: 0; }
  .menu-bars i:last-child { top: 100%; }
  #menu-toggle[aria-expanded="true"] .menu-bars i { top: 50%; }
  #menu-toggle[aria-expanded="true"] .menu-bars i:first-child { transform: rotate(45deg); }
  #menu-toggle[aria-expanded="true"] .menu-bars i:last-child { transform: rotate(-45deg); }

  #mobile-menu:not([hidden]) { animation: menu-in 0.5s var(--ease-out-expo); }
  #mobile-menu:not([hidden]) .menu-item { animation: item-in 0.7s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 55ms + 80ms); }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes item-in { from { opacity: 0; transform: translateY(24px); } }
</style>
