---
const groups = [
  {
    label: 'Data & Engineering',
    tools: ['Python', 'SQL', 'REST APIs', 'GitHub']
  },
  {
    label: 'CRM & Operations',
    tools: ['Salesforce', 'Zoho', 'Custom CRM']
  },
  {
    label: 'Analytics',
    tools: ['GA4', 'Google Tag Manager', 'MS Power BI', 'MS Clarity']
  },
  {
    label: 'Acquisition',
    tools: ['Google Ads', 'LinkedIn Campaign Manager', 'Meta Ads', 'Apify']
  },
  {
    label: 'AI & Interface',
    tools: ['GPT-4o', 'Midjourney', 'Figma', 'HTML/CSS']
  }
];
---

<section id="stack" class="border-y border-stone-200 bg-white/72 py-10">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-6 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Supported Stack</p>
        <h2 class="mt-2 text-2xl font-black tracking-tight text-stone-950 md:text-3xl">Tools used across systems, campaigns, and reporting.</h2>
      </div>
      <p class="max-w-xl text-sm leading-6 text-stone-600">Grouped for clarity. The focus is not tool collection, but how these pieces connect into workable marketing systems.</p>
    </div>

    <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-5">
      {groups.map((group) => (
        <div class="rounded-3xl border border-stone-200 bg-paper p-5">
          <p class="font-mono text-[9px] font-bold uppercase tracking-[0.2em] text-accent">{group.label}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.tools.map((tool) => (
              <span class="pill bg-white">{tool}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
