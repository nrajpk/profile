---
import Layout from '../layouts/Layout.astro';
import HeroStage from '../components/HeroStage.jsx';
import FeaturedIndex from '../components/FeaturedIndex.jsx';
import { projects } from '../data/projects.js';
import { stats } from '../data/site.js';
import { craft, ecosystem } from '../data/systems.js';

// Compact identity strip — the 5-second "who is this" answer.
const path = [
  { period: '2016–2021', label: 'Marketing Foundations', detail: 'Campaigns, landing pages, creative ops' },
  { period: '2022–2023', label: 'Acquisition & Analytics', detail: 'Google Ads, GA4, tracking architecture' },
  { period: '2023–Now', label: 'Growth Engineering', detail: 'Data pipelines, AI qualification, human-in-loop outbound — live in production' },
];

const routes = [
  { name: 'Systems', href: '/systems', line: 'Tools matter less than the handoffs.', body: 'The seven-stage chain from signal to report, and the three layers I work across.' },
  { name: 'Lab', href: '/lab', line: 'Production patterns, rebuilt in the open.', body: 'Four working patterns with small demos you can run.' },
  { name: 'Interface', href: '/interface', line: 'Visual trust, engineered for action.', body: 'How hierarchy, proof placement and layout carry a B2B offer.' },
  { name: 'About', href: '/about', line: 'A marketing path with a technical base.', body: 'Four roles since 2016, and the computer science degree underneath them.' },
];
---

<Layout title="Nikhil Raj PK | Growth Engineer">
  <main id="main" class="relative overflow-x-clip">
    <HeroStage client:load />

    <!-- Kinetic strip: the craft and the ecosystem, moving in opposite directions -->
    <section class="border-y border-stone-200 py-5 space-y-3" aria-label="Tools and disciplines">
      <div class="ticker">
        <div class="ticker-track">
          {[0, 1].map((copy) => (
            <ul class="flex shrink-0" aria-hidden={copy === 1 ? 'true' : undefined}>
              {craft.map((item) => (
                <li class="flex items-center gap-6 pr-6 font-serif text-3xl md:text-4xl whitespace-nowrap">
                  {item}<span class="h-2 w-2 rounded-full bg-zapier"></span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <div class="ticker">
        <div class="ticker-track reverse">
          {[0, 1].map(() => (
            <ul class="flex shrink-0" aria-hidden="true">
              {ecosystem.map((item) => (
                <li class="flex items-center gap-5 pr-5 text-sm font-medium text-stone-500 whitespace-nowrap">
                  {item}<span class="h-px w-6 bg-stone-300"></span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <!-- Who am I -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 py-24 md:py-36">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5" data-reveal>
          <span class="kicker mb-6">Who am I</span>
          <h2 class="font-serif text-4xl md:text-5xl leading-[1.02] tracking-tight">
            A decade of marketing,
            <span class="italic text-stone-400">rebuilt on an engineering base.</span>
          </h2>
          <p class="mt-6 text-stone-600 leading-relaxed max-w-md">
            Most growth engineers started with code and are learning marketing. I went the other way — B.Tech in Computer Science, ten years of marketing judgment, now building the systems growth actually runs on.
          </p>
          <a href="/about" class="link-arrow mt-8">
            The full background
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>

        <ol class="lg:col-span-7 lg:pt-10">
          {path.map((node, i) => (
            <li class="group grid grid-cols-[5.5rem_1fr] md:grid-cols-[8rem_1fr] gap-6 py-6 border-t border-stone-200 last:border-b" data-reveal style={`--d:${i * 120}ms`}>
              <p class="text-sm text-stone-500 tabular-nums pt-1.5">{node.period}</p>
              <div>
                <p class:list={['font-serif text-3xl leading-none transition-transform duration-500 group-hover:translate-x-2', i === path.length - 1 && 'text-zapier']}>{node.label}</p>
                <p class="mt-2 text-stone-600 text-sm leading-relaxed">{node.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Selected work -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 pb-24 md:pb-36">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-reveal>
        <div>
          <span class="kicker mb-6">Selected work</span>
          <h2 class="font-serif text-4xl md:text-6xl leading-[0.98] tracking-tight">
            Production work, <span class="italic text-stone-400">kept factual.</span>
          </h2>
        </div>
        <a href="/work" class="link-arrow">
          All four systems
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
      </div>
      <FeaturedIndex client:visible projects={projects} />
    </section>

    <!-- Verifiable figures -->
    <section class="bg-stone-900 text-white">
      <dl class="max-w-7xl mx-auto px-5 md:px-8 py-16 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12">
        {stats.map((s, i) => (
          <div data-reveal style={`--d:${i * 90}ms`}>
            <dd class="font-serif text-6xl md:text-7xl leading-none tracking-tight tabular-nums">{s.value}</dd>
            <dt class="mt-3 text-sm font-medium text-stone-300">{s.label}</dt>
            <p class="mt-1 text-xs text-stone-500">{s.note}</p>
          </div>
        ))}
      </dl>
    </section>

    <!-- Routes into the rest of the site -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 py-24 md:py-36">
      <h2 class="font-serif text-4xl md:text-6xl leading-[0.98] tracking-tight mb-12 max-w-3xl" data-reveal>
        Four more rooms. <span class="italic text-stone-400">Each one shows a different part of the job.</span>
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 border-t border-l border-stone-200">
        {routes.map((route, i) => (
          <li class="border-r border-b border-stone-200" data-reveal style={`--d:${(i % 2) * 120}ms`}>
            <a href={route.href} class="route group relative block p-7 md:p-10 h-full overflow-hidden">
              <span class="route-fill" aria-hidden="true"></span>
              <span class="relative flex items-start justify-between gap-6">
                <span class="font-serif text-5xl md:text-6xl leading-none">{route.name}</span>
                <svg class="shrink-0 mt-2 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </span>
              <span class="relative block mt-10 md:mt-16 font-semibold">{route.line}</span>
              <span class="route-body relative block mt-2 text-sm leading-relaxed max-w-sm">{route.body}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .route { transition: color 0.5s var(--ease-out-expo); }
  .route-body { color: var(--color-stone-600); transition: color 0.5s var(--ease-out-expo); }
  .route-fill {
    position: absolute; inset: 0; background: var(--color-zapier);
    clip-path: circle(0% at 100% 0%);
    transition: clip-path 0.8s var(--ease-out-expo);
  }
  .route:hover, .route:focus-visible { color: #fff; }
  .route:hover .route-body, .route:focus-visible .route-body { color: #fff; }
  .route:hover .route-fill, .route:focus-visible .route-fill { clip-path: circle(150% at 100% 0%); }
</style>
