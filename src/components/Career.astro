---
// Career history as a plain, scannable list: dates, company and role first,
// then what was done. Same data as the CV.
import { roles } from '../data/career.js';
---

<ol class="border-t border-stone-900">
  {roles.map((job, i) => (
    <li class="grid grid-cols-1 lg:grid-cols-12 gap-x-14 gap-y-6 py-12 md:py-14 border-b border-stone-200">
      <div class="lg:col-span-4">
        <p class:list={['text-sm font-semibold tabular-nums', i === 0 ? 'text-zapier-ink' : 'text-stone-600']}>{job.period}</p>
        <p class="mt-3 font-serif text-3xl md:text-4xl leading-[1.05] tracking-tight">{job.company}</p>
        <p class="mt-3 text-sm text-stone-600">{job.location} · {job.sector}</p>
      </div>
      <div class="lg:col-span-8">
        <h3 class="text-xl md:text-2xl font-semibold tracking-tight">{job.role}</h3>
        <p class="mt-3 text-stone-600 leading-relaxed max-w-2xl">{job.summary}</p>
        <ul class="mt-6 space-y-3 max-w-2xl">
          {job.highlights.map((point) => (
            <li class="grid grid-cols-[0.75rem_1fr] gap-3 text-stone-700 leading-relaxed">
              <span class="mt-2.5 h-1.5 w-1.5 rounded-full bg-zapier" aria-hidden="true"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tools">
          {job.tools.map((tool) => (
            <li class="px-3 py-1.5 border border-stone-300 rounded-full text-xs font-medium text-stone-600">{tool}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>
