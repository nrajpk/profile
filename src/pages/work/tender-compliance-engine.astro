---
import CaseStudy from '../../components/CaseStudy.astro';

// VERIFIED BUILD FIGURES — from project status & deployment docs (v1, July 2026).
const figures = {
  asOf: 'July 2026 (v1 production-readiness pass)',
  tests: '37/37',
  routingStages: 6,
  endpoints: 10,
  internalStatuses: 7,
  platforms: 6,
  templates: 11,
};

const decisions = [
  {
    n: '01',
    title: 'AI runs last — and in v1, not at all',
    what: 'Requirement rows route through six stages in strict order: approved cache → safety hold → numeric spec check → platform capability check → template match → AI. The AI stage is a conservative stub that outputs "Manual Review Needed" — no model call is made anywhere in v1.',
    whyNot: 'The obvious 2026 build is "feed the tender to an LLM." But a hallucinated "Comply" on a ballistic spec is a contractual claim, not a typo. Deterministic checks answer what can be proven; everything else is honestly routed to a human. The AIResponder interface exists so a real model can slot in later — behind the same guardrails, never in front of them.',
  },
  {
    n: '02',
    title: 'A safety hold that no automation can override',
    what: 'Rows touching ballistic protection levels (VPAM, STANAG, CEN 1063, BR4–7), payload, upgraded GVW, suspension, brakes, or armoured configuration are held at Manual Review Needed — always — unless a human-approved cache entry explicitly covers them.',
    whyNot: 'These are the rows where a wrong answer costs a contract or worse. The design question wasn\'t "can we automate this?" — it was "what must never be automated?" The safety hold runs second in the pipeline, before any check that could mark a row compliant.',
  },
  {
    n: '03',
    title: 'No evidence, no "Compliant"',
    what: 'A post-validation layer enforces evidence-or-downgrade: any row marked Compliant without an attached evidence trail is automatically downgraded. The exported DOCX carries a traceability appendix mapping every matrix row to its source document, page, and clause.',
    whyNot: 'Compliance matrices fail audits on unsupported claims, not missing ones. Making evidence structurally mandatory means the output is defensible in front of a procurement officer, not just impressive in a demo.',
  },
  {
    n: '04',
    title: 'Human review compounds into a response library',
    what: 'When a reviewer approves rows, they write back into a normalized-key approved cache — which is stage one of the pipeline. The next tender that asks the same question gets the human-approved answer instantly.',
    whyNot: 'The fashionable version is fine-tuning a model on past responses. The cache achieves the compounding without training cost, drift, or opacity: every cached answer was explicitly approved by a person, and the cache file itself is the single most valuable backup artifact.',
  },
  {
    n: '05',
    title: 'The tender is locked as an immutable "case bible"',
    what: 'On upload, the source PDF is locked per case. Extraction, review, and export all trace back to it; parsed pages are kept as an auditable intermediate so even dropped clauses remain inspectable.',
    whyNot: 'Compliance work collapses when the source document can silently change mid-review. Immutability makes every downstream edit accountable to one fixed reference — the same discipline as a contract redline.',
  },
  {
    n: '06',
    title: 'Limitations are documented, not hidden',
    what: 'No OCR — scanned PDFs are flagged as possibly scanned rather than guessed at. Narrow numeric coverage by design: units outside the verified set route to manual review. Every known parsing edge case is written down in the project docs.',
    whyNot: 'A system that guesses at the 5% it can\'t parse poisons trust in the 95% it can. Flagging over guessing is what makes reviewers actually rely on the tool — the failure modes are part of the spec, not a surprise.',
  },
];

const pipeline = [
  'Case created — platform selected, tender PDF locked as case bible',
  'Page-wise extraction with numbered-clause detection',
  'Hierarchy normalization — refs, leaf detection, categories',
  'Stage 1 · Approved cache lookup (human-approved answers)',
  'Stage 2 · Safety hold — ballistic / payload rows frozen for review',
  'Stage 3 · Numeric spec check against platform data',
  'Stage 4 · Deterministic platform capability check',
  'Stage 5 · Response template match',
  'Stage 6 · Conservative AI stub → Manual Review Needed',
  'Evidence-or-downgrade validation, human review, cache write-back',
  'DOCX generation — clean matrix + traceability appendix',
];

const stack = ['Python / FastAPI', 'PyMuPDF', 'python-docx', 'React 18 + Vite', 'Supabase Auth', 'Docker', 'pytest'];
---

<CaseStudy
  slug="tender-compliance-engine"
  title="Tender Compliance Engine — System Breakdown | Nikhil Raj PK"
  description="A production tender-compliance matrix generator for armoured vehicle bids: deterministic routing, an un-overridable safety hold, evidence-enforced compliance claims, and a human-approved response cache. 37/37 tests, Dockerized."
  headline="A tender-response engine built around one rule:"
  headlineQuiet="never guess on compliance."
  lede={'Defense tenders arrive as hundreds of numbered requirements. Building the compliance matrix by hand takes days — and a single careless "Comply" is a contractual claim. This system automates the drudgery while making the dangerous parts impossible to automate.'}
  figures={{
    label: 'Verified build figures',
    asOf: figures.asOf,
    items: [
      { value: figures.tests, label: 'Tests passing' },
      { value: figures.routingStages, label: 'Routing stages' },
      { value: figures.endpoints, label: 'API endpoints' },
      { value: `${figures.internalStatuses} → 4`, label: 'Statuses, collapsed at export' },
    ],
    note: `End-to-end verified: create case → upload → extract → review → approve-to-cache → generate DOCX → download. Ships as a single Docker container serving API and frontend, with ${figures.platforms} vehicle platform spec sets and ${figures.templates} response templates seeded. Supabase-backed auth; JSON-file storage by deliberate v1 scope, behind interfaces ready for Postgres/S3.`,
  }}
  problem="Every tender response meant manually reading hundreds of clauses, deciding Comply / Partial / Non-Comply per row, writing responses, and assembling a formatted matrix — days of expert time spent mostly on requirements the company had already answered in previous bids."
  constraint={'A compliance matrix is a legal representation to a procurement authority. Speed was worthless without defensibility — so the architecture optimizes for "provably correct or explicitly flagged," never "probably right."'}
  sequence={{ title: 'The pipeline.', steps: pipeline }}
  decisionsTitle="Six decisions that define the system."
  decisionsIntro="The engineering here is mostly restraint: deciding what the machine must never answer, and making that impossible rather than merely discouraged."
  decisions={decisions}
  stack={stack}
  disclosure={`Figures are taken from the project's status and deployment documentation (${figures.asOf}). Tender contents, client data, and platform-specific specification values are omitted. Known limitations (no OCR, narrow numeric coverage, single-process storage) are part of the documented v1 scope — flagged in the system itself, not discovered by users.`}
  walkthrough="I can demo the full flow live — tender PDF in, reviewed compliance matrix and DOCX out — and walk through the routing code and safety-hold logic on screen."
/>
