---
import '../styles/global.css';
const {
  title = 'Nikhil Raj PK | Marketing Operations & GTM Systems Builder',
  description = 'Nikhil Raj PK builds practical GTM systems across marketing operations, CRM workflows, analytics, data extraction, automation, API handoffs and AI-assisted workflows.'
} = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F8F6" />
    <title>{title}</title>
  </head>
  <body class="dot-grid font-sans bg-paper text-stone-900 antialiased selection:bg-orange-100 selection:text-orange-900">
    <slot />
  </body>
</html>
