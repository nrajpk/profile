---
import CaseStudy from '../../components/CaseStudy.astro';

// PRODUCT SCOPE FACTS — observed from the live production system, July 2026.
// Deliberately no pipeline counts, deal values, or client data.
const scope = {
  asOf: 'July 2026 — live in production',
  leadStatuses: 5,
  oppStates: 5,
  sourceClasses: 3,
  modules: 'Leads · Opportunities · Role dashboards · Coordination calendar',
};

const decisions = [
  {
    n: '01',
    title: 'The pipeline is denominated in units, not just money',
    what: 'Dashboards track pipeline units alongside estimated value, and sales targets are set as units confirmed per fiscal year. A deal is N vehicles in a configuration; revenue is derived from that, not typed over it.',
    whyNot: 'Generic CRMs model deals as a currency amount with a probability. In armoured vehicle sales the unit count and configuration are the deal — value follows from them. Modeling the domain\'s real primitive was the single biggest break from both the Excel era and off-the-shelf CRM defaults.',
  },
  {
    n: '02',
    title: 'Leads and opportunities are separate objects with separate lifecycles',
    what: 'Leads move through their own status set (cold → hot → opportunity → rejected) before conversion; opportunities then carry their own temperature and a first-class proposal state — "not initiated" vs "proposal generated" is tracked data, not a comment.',
    whyNot: 'In the spreadsheet era one row served as lead, opportunity, and proposal log at once — so nobody could say how many real opportunities existed or which ones had never received a proposal. Splitting the objects made the funnel measurable at each conversion point.',
  },
  {
    n: '03',
    title: 'Lead source attribution is baked into the schema',
    what: 'Every lead is classified at entry: self-prospected, company-provided, or other. Dashboards split performance along exactly these lines, next to each BDM\'s fiscal-year unit target.',
    whyNot: 'When attribution lives in people\'s memory, target reviews become arguments. Making source a mandatory field turned "who actually generated this" from a debate into a report — and made self-prospecting visible enough to be worth doing.',
  },
  {
    n: '04',
    title: 'Follow-up is a system function, not a habit',
    what: 'A follow-up tracker with dated reminders sits on the dashboard; every lead and opportunity row carries an add-follow-up action. The failure mode being engineered against: first contact, then silence.',
    whyNot: 'Excel cannot nag anyone. In long-cycle B2G sales where deals move over months, the system that remembers on the seller\'s behalf is the difference between a pipeline and a contact list.',
  },
  {
    n: '05',
    title: 'Tender deadlines live in the same system as the pipeline',
    what: 'A coordination calendar carries corporate events, country-specific national days, and tender deadlines — both manually added and system-found tenders surfaced by automated discovery — exportable per date range.',
    whyNot: 'Tender dates in one tool and pipeline in another means missed deadlines fall between systems. Putting automated tender discovery inside the CRM connects "an RFP exists" to "someone owns it" in one place. National-day tracking matters in this market: outreach timing around them is a real variable.',
  },
  {
    n: '06',
    title: 'Owned as a product, delivered through a partner',
    what: 'I owned the product: lifecycle design, field schema, source attribution rules, dashboard and reporting logic, and role structure. A development partner built and maintains the application to that specification.',
    whyNot: 'Pretending to have coded it would be the flattering version — and the fragile one. Product ownership is the honest claim and the transferable skill: knowing what the sales operation needs, specifying it precisely, and iterating it against real usage.',
  },
];

const beforeAfter = [
  { before: 'Excel workbooks + Access, passed between users with version-name file management', after: 'Multi-user web CRM with role-based access, live for the sales team' },
  { before: 'One row = lead, opportunity, and notes at once', after: 'Separate lead and opportunity objects with distinct lifecycles and proposal states' },
  { before: 'Lead origin remembered, argued, or lost', after: 'Mandatory source attribution: self-prospected / company-provided / other' },
  { before: 'Follow-ups dependent on individual discipline', after: 'Dated follow-up tracker with reminders on the dashboard' },
  { before: 'Management reporting = manual consolidation before reviews', after: 'Live funnel, activity, and target-achievement views per role and date range' },
  { before: 'Tender deadlines tracked outside the sales tooling', after: 'Tender calendar in-system, including automated tender discovery' },
];
---

<CaseStudy
  slug="crm-product-ownership"
  title="CRM Product Ownership — System Breakdown | Nikhil Raj PK"
  description="How an Excel-and-Access sales process became a custom CRM for long-cycle armoured vehicle sales: unit-denominated pipeline, schema-level source attribution, systematized follow-up, and in-system tender deadlines."
  headline="The CRM that replaced"
  headlineQuiet="a decade of spreadsheets."
  lede="Global armoured vehicle sales ran on Excel workbooks and an Access database — workable at small scale, blind at real scale. I owned the product design of its replacement: a custom CRM whose every schema decision encodes how long-cycle B2G selling actually works."
  figures={{
    label: 'Product scope',
    asOf: scope.asOf,
    items: [
      { value: scope.leadStatuses, label: 'Lead lifecycle states' },
      { value: scope.oppStates, label: 'Opportunity states' },
      { value: scope.sourceClasses, label: 'Source attribution classes' },
      { value: 'Units', label: 'Pipeline denomination' },
    ],
    note: `Core modules: ${scope.modules}. Role-based dashboards carry fiscal-year unit targets, activity and funnel views, and a follow-up tracker. Pipeline figures, client identities, and deal data are deliberately not shown here.`,
  }}
  comparison={{ title: 'From workbook to operating system.', beforeLabel: 'Excel + Access era', afterLabel: 'Custom CRM', rows: beforeAfter }}
  decisionsTitle="Six decisions that define the product."
  decisionsIntro="None of these are technical flourishes. Each one encodes something true about how armoured vehicles are actually sold — which is what a custom CRM is for."
  decisions={decisions}
  disclosure="Described from the live production system as of July 2026. The application was developed by an external partner to an internally owned product specification; my role is product ownership — lifecycle design, schema, reporting logic, and iteration against real sales usage. All pipeline figures, client names, and deal details are excluded by design."
  walkthrough="I can walk through the lifecycle model, the attribution and target logic, and how the product evolved from the first spreadsheet audit to the current build."
/>
