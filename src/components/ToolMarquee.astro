---
// The handoff chain — the section now shows what the headline claims.
const chain = [
  {
    n: '01',
    verb: 'Source',
    line: 'Find the signal',
    tools: ['Python', 'Apify', 'Apollo', 'LinkedIn'],
  },
  {
    n: '02',
    verb: 'Enrich',
    line: 'Complete the record',
    tools: ['REST APIs', 'Waterfall logic', 'CSV/JSON'],
  },
  {
    n: '03',
    verb: 'Qualify',
    line: 'Score against ICP',
    tools: ['LLM APIs', 'Prompt specs', 'JSON output'],
  },
  {
    n: '04',
    verb: 'Approve',
    line: 'A human decides',
    tools: ['Airtable', 'Review console'],
  },
  {
    n: '05',
    verb: 'Send',
    line: 'Reach out, carefully',
    tools: ['Instantly', 'Smartlead', 'n8n', 'Webhooks'],
  },
  {
    n: '06',
    verb: 'Track',
    line: 'Measure what matters',
    tools: ['GA4', 'GTM', 'MS Clarity'],
  },
  {
    n: '07',
    verb: 'Report',
    line: 'One version of truth',
    tools: ['Power BI', 'Custom CRM', 'SQL'],
  },
];

const ecosystem = [
  'Salesforce', 'Zoho', 'HubSpot', 'Clay', 'ZoomInfo', 'Clearbit', 'Make',
  'Zapier', '6sense', 'Gong', 'Snowflake', 'BigQuery', 'Google Ads',
  'Meta Ads', 'Figma', 'GitHub', 'Supabase', 'Next.js', 'FastAPI'
];
---

<section id="stack" class="py-20 px-6 border-y border-stone-100 bg-paper overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
      <div>
        <span class="font-mono text-[10px] font-bold text-zapier uppercase tracking-[0.35em] mb-4 block">
          GTM Stack Map
        </span>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-stone-900 italic font-serif">
          Tools matter less than the handoffs.
        </h2>
      </div>
      <p class="max-w-xl text-stone-500 leading-relaxed">
        I'm a digital marketer at the core — campaigns, paid media, creative. The chain below is what I've built around that craft, so every campaign runs on clean data and clear handoffs.
      </p>
    </div>

    <!-- The handoff chain -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-10">
      {chain.map((stage, i) => (
        <article class="relative bg-white border border-stone-200 rounded-2xl p-4 hover:border-zapier/40 transition-colors">
          {i < chain.length - 1 && (
            <span class="hidden lg:flex absolute -right-4 top-1/2 -translate-y-1/2 w-4 h-4 items-center justify-center text-zapier/60 text-[10px] leading-none z-10 pointer-events-none">&rarr;</span>
          )}
          <p class="font-mono text-[9px] font-bold text-zapier mb-2">{stage.n}</p>
          <p class="font-bold text-stone-900 leading-tight">{stage.verb}</p>
          <p class="text-[11px] text-stone-400 mb-3 leading-snug">{stage.line}</p>
          <div class="flex flex-wrap gap-1">
            {stage.tools.map((tool) => (
              <span class="font-mono text-[7px] font-bold uppercase tracking-[0.14em] text-stone-500 bg-paper border border-stone-200 rounded px-1.5 py-1">
                {tool}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Two lanes: the craft and the systems around it -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="bg-white border border-stone-200 rounded-2xl p-6">
        <p class="font-mono text-[9px] font-bold uppercase tracking-[0.25em] text-zapier mb-1.5">
          The marketing craft
        </p>
        <p class="text-xs text-stone-400 mb-4">Where I come from — and still operate daily.</p>
        <div class="flex flex-wrap gap-2">
          {['Google Ads', 'Meta Ads', 'LinkedIn Campaign Manager', 'GA4', 'GTM', 'MS Clarity', 'Landing Pages / CRO', 'Email Campaigns', 'Figma', 'Adobe Suite', 'Content & Creative Ops'].map((tool) => (
            <span class="font-mono text-[8px] font-bold uppercase tracking-[0.16em] text-stone-600 bg-paper border border-stone-300 rounded-lg px-2.5 py-1.5 hover:text-zapier hover:border-zapier/40 transition-colors cursor-default">
              {tool}
            </span>
          ))}
        </div>
      </div>
      <div class="bg-white border border-stone-200 rounded-2xl p-6">
        <p class="font-mono text-[9px] font-bold uppercase tracking-[0.25em] text-stone-400 mb-1.5">
          The systems ecosystem
        </p>
        <p class="text-xs text-stone-400 mb-4">What I build with, integrate, or design workflows around.</p>
        <div class="flex flex-wrap gap-2">
          {ecosystem.map((tool) => (
            <span class="font-mono text-[8px] font-bold uppercase tracking-[0.16em] text-stone-400 bg-paper border border-stone-200 rounded-lg px-2.5 py-1.5 hover:text-zapier hover:border-zapier/30 transition-colors cursor-default">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
