---
import Layout from '../../layouts/Layout.astro';
import ProjectCover from '../../components/ProjectCover.jsx';
import { projects } from '../../data/projects.js';
import ArchiveCover from '../../components/ArchiveCover.jsx';
import { archive, groups, statusLabels } from '../../data/archive.js';
import { chains } from '../../data/compose.js';
import { person } from '../../data/site.js';

const chainNames = Object.fromEntries(chains.map((c) => [c.id, c.tab]));
const count = (n) => ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen', 'twenty'][n] ?? String(n);
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
---

<Layout
  title={`Work — Production Systems | ${person.name}`}
  description={`${count(projects.length)[0].toUpperCase() + count(projects.length).slice(1)} production systems across data extraction, CRM product ownership, tender compliance and production tracking — each with what changed, its flow and sanitized evidence — plus ${archive.length} more builds.`}
>
  <main id="main" class="overflow-x-clip">
    <header class="max-w-7xl mx-auto px-5 md:px-8 pt-32 md:pt-44 pb-16 md:pb-24 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <span class="kicker mb-8">Built Work — Production Systems</span>
        <h1 class="display">
          Production work, <br /><span class="italic text-quiet">kept factual.</span>
        </h1>
      </div>
      <p class="lg:col-span-4 text-stone-600 leading-relaxed">
        Real work across data extraction, CRM workflows, paid acquisition and reporting. No fake metrics, no invented outcomes, only systems that can be explained and shown with sanitized evidence.
      </p>
    </header>

    <!-- In-page index -->
    <nav class="sticky top-16 z-30 bg-paper/90 backdrop-blur-md border-y border-stone-200" aria-label="Systems on this page">
      <ul class="max-w-7xl mx-auto px-5 md:px-8 flex gap-6 md:gap-10 overflow-x-auto no-scrollbar">
        {projects.map((p) => (
          <li class="shrink-0">
            <a href={`#${p.slug}`} class="block py-3.5 text-sm font-medium text-stone-600 hover:text-zapier-ink transition-colors whitespace-nowrap">{p.label}</a>
          </li>
        ))}
        <li class="shrink-0 self-center h-4 w-px bg-stone-300" aria-hidden="true"></li>
        {groups.map((g) => (
          <li class="shrink-0">
            <a href={`#${g.id}`} class="block py-3.5 text-sm font-medium text-stone-600 hover:text-zapier-ink transition-colors whitespace-nowrap">{g.name} <span class="text-stone-500 tabular-nums">{archive.filter((i) => i.group === g.id).length}</span></a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="max-w-7xl mx-auto px-5 md:px-8">
      {projects.map((p, i) => (
        <article id={p.slug} class="scroll-mt-32 py-16 md:py-28 border-b border-stone-200 last:border-b-0 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          <a
            href={p.href}
            aria-label={`${p.title} — full system breakdown`}
            class:list={[
              'cover-frame group block bg-stone-100 border border-stone-200 p-4 md:p-8',
              i % 2 === 0 ? 'lg:col-span-7' : 'lg:col-span-6 lg:order-2 lg:mt-24',
            ]}
            data-reveal="wipe"
          >
            <ProjectCover kind={p.cover} className="transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
          </a>

          <div class:list={[i % 2 === 0 ? 'lg:col-span-5' : 'lg:col-span-6 lg:order-1']}>
            <p class="label flex items-center gap-2 mb-5">
              <span class:list={['h-1.5 w-1.5 rounded-full', p.status.startsWith('Live') ? 'bg-green-500' : 'bg-zapier']}></span> {p.status}
            </p>
            <h2 class="font-serif text-4xl md:text-5xl leading-[1.02] tracking-tight">
              <a href={p.href} class="hover:text-zapier-ink transition-colors">{p.title}</a>
            </h2>
            <p class="mt-5 text-lg text-stone-600 leading-relaxed">{p.desc}</p>

            <h3 class="mt-10 label">What changed</h3>
            <dl class="mt-4 border-l border-stone-300 pl-5 space-y-3">
              <div>
                <dt class="sr-only">Before</dt>
                <dd class="text-stone-600 leading-relaxed">{p.before}</dd>
              </div>
              <div>
                <dt class="sr-only">Now</dt>
                <dd class="font-serif text-2xl leading-[1.15]">{p.after}</dd>
              </div>
            </dl>

            <h3 class="mt-10 label">How it flows</h3>
            <ol class="mt-4 flow">
              {p.flow.map((step) => (
                <li class="flow-step">{step}</li>
              ))}
            </ol>

            <h3 class="mt-10 label">Evidence I can walk through</h3>
            <p class="mt-3 text-sm text-stone-600 leading-relaxed">{p.proof}</p>

            <ul class="mt-6 flex flex-wrap gap-2">
              {p.tools.map((tool) => (
                <li class="px-3 py-1.5 border border-stone-300 rounded-full text-xs font-medium text-stone-600">{tool}</li>
              ))}
            </ul>

            <a href={p.href} class="link-arrow mt-9">
              Read the full system breakdown
              <Fragment set:html={arrow} />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- The wider body of work: a compact index, each entry opens in place -->
    <section id="more-work" class="scroll-mt-32 border-t border-stone-200">
      <div class="max-w-7xl mx-auto px-5 md:px-8 pt-20 md:pt-32 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
        <h2 class="lg:col-span-8 font-serif text-5xl md:text-6xl leading-[0.98] tracking-tight">
          And the rest of the bench. <span class="italic text-quiet">{count(archive.length)[0].toUpperCase() + count(archive.length).slice(1)} more builds.</span>
        </h2>
        <p class="lg:col-span-4 text-stone-600 leading-relaxed">
          Company platforms, my own products, builds for friends and experiments. Open any of them for its diagram, flow and evidence.
        </p>
      </div>

      {groups.map((group) => (
        <div id={group.id} class="scroll-mt-32 max-w-7xl mx-auto px-5 md:px-8 pt-16 md:pt-24">
          <header class="flex flex-col md:flex-row md:items-baseline justify-between gap-3 border-b border-stone-900 pb-5">
            <h3 class="font-serif italic text-4xl md:text-5xl leading-none tracking-tight">{group.name}</h3>
            <p class="text-stone-600">{group.line}</p>
          </header>

          <ul>
            {archive.filter((item) => item.group === group.id).map((p) => (
              <li class="border-b border-stone-200">
                <details id={p.id} class="archive-item scroll-mt-32">
                  <summary class="grid grid-cols-[1fr_auto] md:grid-cols-12 gap-x-6 gap-y-2 py-6 md:py-7 cursor-pointer">
                    <span class="md:col-span-2 label flex items-center gap-2 md:pt-2 order-first">
                      <span class:list={['h-1.5 w-1.5 rounded-full shrink-0', p.status === 'live' ? 'bg-green-500' : 'bg-zapier']}></span>
                      {statusLabels[p.status]}
                    </span>
                    <h4 class="col-span-2 md:col-span-4 font-serif font-normal text-3xl md:text-[2.1rem] leading-[1.05] tracking-tight">{p.title}</h4>
                    <span class="col-span-2 md:col-span-5 text-stone-600 leading-relaxed">{p.desc}</span>
                    <span class="row-start-1 col-start-2 md:row-start-auto md:col-start-auto md:col-span-1 justify-self-end self-start mt-0.5 md:mt-1 h-9 w-9 rounded-full border border-stone-300 flex items-center justify-center toggle" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    </span>
                  </summary>

                  <div class="pb-12 grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-10">
                    <div class="md:col-start-3 md:col-span-5 bg-stone-100 border border-stone-200 overflow-hidden self-start">
                      {p.cover.image ? (
                        <img src={p.cover.image} alt={p.cover.alt} width={p.cover.width} height={p.cover.height} loading="lazy" class="w-full h-auto" />
                      ) : (
                        <div class="p-4 md:p-5">
                          <ArchiveCover cover={p.cover} />
                        </div>
                      )}
                    </div>
                    <div class="md:col-span-5">
                      <h5 class="label">How it flows</h5>
                      <ol class="mt-4 flow">
                        {p.flow.map((step) => (
                          <li class="flow-step">{step}</li>
                        ))}
                      </ol>

                      <h5 class="mt-8 label">Evidence</h5>
                      <p class="mt-3 text-sm text-stone-600 leading-relaxed">{p.proof}</p>

                      <ul class="mt-6 flex flex-wrap gap-2">
                        {p.tools.map((tool) => (
                          <li class="px-3 py-1.5 border border-stone-300 rounded-full text-xs font-medium text-stone-600">{tool}</li>
                        ))}
                      </ul>

                      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
                        {p.link && (
                          <a href={p.link.href} target="_blank" rel="noreferrer" class="link-arrow">
                            {p.link.label}
                            <Fragment set:html={arrow} />
                          </a>
                        )}
                        {p.related && (
                          <a href={p.related.href} class="link-arrow">
                            {p.related.label}
                            <Fragment set:html={arrow} />
                          </a>
                        )}
                        {p.chain && (
                          <a href={`/systems#compose-${p.chain}`} class="link-arrow">
                            {chainNames[p.chain]} system
                            <Fragment set:html={arrow} />
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="h-24 md:h-36"></div>
    </section>

    <section class="bg-stone-900 text-white">
      <div class="max-w-7xl mx-auto px-5 md:px-8 py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
        <h2 class="lg:col-span-7 font-serif italic text-5xl md:text-6xl leading-[0.98] tracking-tight">The work is the system.</h2>
        <div class="lg:col-span-5">
          <p class="text-stone-300 leading-relaxed">
            Where a system touches acquisition, its measurement is part of the build: GTM events, GA4 conversions, source-to-CRM attribution and reporting views leadership actually opens.
          </p>
          <a href="/systems" class="link-arrow mt-6">
            See how the layers connect
            <Fragment set:html={arrow} />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .archive-item summary { list-style: none; }
  .archive-item summary::-webkit-details-marker { display: none; }
  .archive-item summary:hover .toggle { border-color: var(--color-stone-900); }
  .archive-item .toggle svg { transition: transform 0.4s var(--ease-out-expo); }
  .archive-item[open] .toggle { background: var(--color-stone-900); border-color: var(--color-stone-900); color: var(--color-paper); }
  .archive-item[open] .toggle svg { transform: rotate(45deg); }
</style>
