---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.jsx';
import HeroNarrative from '../components/HeroNarrative.jsx';
import WhoAmI from '../components/WhoAmI.astro';
import ToolMarquee from '../components/ToolMarquee.astro';
import BentoSystems from '../components/BentoSystems.jsx';
import HighTicketProof from '../components/HighTicketProof.jsx';
import UtilityLab from '../components/UtilityLab.jsx';
import CreativeStudio from '../components/CreativeStudio.jsx';
import CareerArchitecture from '../components/CareerArchitecture.jsx';
---

<Layout title="Nikhil Raj PK | Growth Engineer — Marketing Ops & GTM Systems">
  <div class="fixed top-0 left-0 h-1 bg-zapier z-[60]" id="pb"></div>
  <Navigation client:load />
  
  <main class="relative">
    <HeroNarrative client:load />
    <WhoAmI />
    <ToolMarquee />
    <BentoSystems client:visible />
    <HighTicketProof client:visible />
    <UtilityLab client:visible />
    <CreativeStudio client:visible />
    <CareerArchitecture client:visible />

    <section id="contact" class="py-36 px-6 text-center bg-white border-t border-stone-100 relative overflow-hidden">
      <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: linear-gradient(#111 1px, transparent 1px), linear-gradient(90deg, #111 1px, transparent 1px); background-size: 48px 48px;"></div>
      <div class="max-w-3xl mx-auto relative z-10">
        <span class="font-mono text-[10px] font-bold text-zapier uppercase tracking-[0.35em] mb-6 block">Contact</span>
        <h2 class="text-5xl md:text-7xl font-bold mb-8 tracking-tighter italic font-serif text-stone-900">
          Let’s map the workflow.
        </h2>
        <p class="text-stone-500 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-12">
          If your marketing stack depends on manual research, disconnected CRM data, unclear attribution or slow lead handling, I can help think through a cleaner system.
        </p>
        <a href="mailto:nrajpk@outlook.com" class="bg-stone-900 text-white px-12 py-5 rounded-full font-bold uppercase tracking-widest text-xs shadow-2xl hover:bg-zapier transition-all active:scale-95 inline-flex items-center justify-center">
          Start a Systems Conversation
        </a>
      </div>
    </section>
  </main>
</Layout>
