---
import Layout from '../layouts/Layout.astro';
import { ArchitectEye, FormatReframe, OpticalInspectionLens, ConversionOptimizerDemo } from '../components/InterfaceDemos.jsx';
import { skins } from '../data/site.js';

const skinNotes = {
  paper: 'Warm off-white, dark type, one orange. The default.',
  ink: 'The same scale inverted for low light.',
  blueprint: 'Drafting-table blue with a measured grid.',
};
---

<Layout
  title="Interface — Visual Trust, Engineered for Action | Nikhil Raj PK"
  description="How visual hierarchy, landing page structure, proof placement and production detail make complex B2B offers easier to understand, trust and act on."
>
  <main id="main" class="overflow-x-clip">
    <header class="max-w-7xl mx-auto px-5 md:px-8 pt-32 md:pt-44 pb-16 md:pb-24 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-8">
        <span class="kicker mb-8">Interface Layer — Conversion Systems</span>
        <h1 class="display" data-reveal="wipe">
          Visual trust, <br /><span class="italic text-stone-400">engineered for action.</span>
        </h1>
        <p class="mt-8 text-lg text-stone-600 leading-relaxed max-w-xl" data-reveal style="--d:150ms">
          The interface is part of the GTM system. I use visual hierarchy, landing page structure, proof placement and production detail to make complex B2B offers easier to understand, trust and act on.
        </p>
      </div>
      <div class="lg:col-span-4 flex lg:justify-end" data-reveal style="--d:250ms">
        <ArchitectEye client:load />
      </div>
    </header>

    <!-- Asset systems + detail imagery: an uneven pair -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 pb-24 md:pb-32 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-20">
      <div class="lg:col-span-7" data-reveal>
        <FormatReframe client:visible />
        <h2 class="mt-8 font-serif text-4xl md:text-5xl leading-none tracking-tight">Visual Asset Systems.</h2>
        <p class="mt-4 text-stone-600 leading-relaxed max-w-lg">
          Controlled visual workflows for turning technical products and industrial complexity into credible campaign assets, launch visuals and sales-supporting media.
        </p>
        <p class="mt-3 text-sm text-stone-500 max-w-lg">Pick a placement. One composition, re-cropped for each — built from this site's own portrait and palette.</p>
      </div>

      <div class="lg:col-span-5 lg:mt-28" data-reveal style="--d:120ms">
        <OpticalInspectionLens client:visible />
        <h2 class="mt-8 font-serif text-4xl md:text-5xl leading-none tracking-tight">Product &amp; Detail Imagery.</h2>
        <p class="mt-4 text-stone-600 leading-relaxed max-w-md">
          Image direction focused on material clarity, product credibility and the small visual details that shape trust.
        </p>
      </div>
    </section>

    <!-- Conversion interface -->
    <section class="bg-stone-100 border-y border-stone-200">
      <div class="max-w-7xl mx-auto px-5 md:px-8 py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7" data-reveal>
          <span class="kicker mb-6">UX / UI &amp; CRO</span>
          <h2 class="font-serif text-5xl md:text-6xl leading-[0.98] tracking-tight">Conversion Interface.</h2>
          <p class="mt-6 text-lg text-stone-600 leading-relaxed max-w-xl">
            Landing pages and campaign interfaces work best when message, hierarchy, proof and form logic are aligned. This layer connects design decisions with marketing operations and lead flow.
          </p>
          <ul class="mt-8 flex flex-wrap gap-2">
            {['Figma', 'HTML/CSS', 'Form Logic', 'Clarity Review', 'AI Asset Direction'].map((t) => (
              <li class="px-3.5 py-2 border border-stone-300 rounded-full text-sm font-medium text-stone-700">{t}</li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-5 flex lg:justify-end" data-reveal style="--d:150ms">
          <ConversionOptimizerDemo client:visible />
        </div>
      </div>
    </section>

    <!-- Shipped and built interfaces -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 pt-24 md:pt-36">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end mb-12 md:mb-16">
        <h2 class="lg:col-span-8 font-serif text-5xl md:text-6xl leading-[0.98] tracking-tight" data-reveal>
          Interfaces that exist. <span class="italic text-stone-400">Not mock-ups of ones that might.</span>
        </h2>
        <p class="lg:col-span-4 text-stone-600 leading-relaxed" data-reveal style="--d:120ms">
          A live company site, a film written in code and a full workshop site prototype. Each caption says what it is and what my part was.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-16">
        <figure class="lg:col-span-7" data-reveal="wipe">
          <a href="https://www.mahindraarmored.com" target="_blank" rel="noreferrer" class="shot block overflow-hidden border border-stone-200">
            <img src="/work/mahindraarmored.webp" alt="The mahindraarmored.com homepage: navigation, language selector and a full-width vehicle test-track hero." width="1400" height="875" loading="lazy" class="w-full h-auto" />
          </a>
          <figcaption class="mt-5">
            <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500"><span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>Live · company website</span>
            <span class="block mt-2 font-serif text-3xl md:text-4xl leading-none tracking-tight">mahindraarmored.com</span>
            <span class="block mt-3 text-stone-600 leading-relaxed max-w-xl">Four languages on a Next.js front end. Built with an agency; my commits cover page-level SEO, the performance and accessibility passes, the vehicle gallery and staged releases. Screenshot of the live site, October 2026.</span>
          </figcaption>
        </figure>

        <figure class="lg:col-span-5 lg:mt-32" data-reveal="wipe" style="--d:120ms">
          <div class="shot overflow-hidden border border-stone-200">
            <img src="/work/brand-film.webp" alt="A frame from the brand film: a line of armoured vehicles outside the factory, captioned Fleets, built to order, scene 6 of 12." width="1600" height="900" loading="lazy" class="w-full h-auto" />
          </div>
          <figcaption class="mt-5">
            <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500"><span class="h-1.5 w-1.5 rounded-full bg-stone-400"></span>Creative · film in code</span>
            <span class="block mt-2 font-serif text-3xl md:text-4xl leading-none tracking-tight">MEVA brand film</span>
            <span class="block mt-3 text-stone-600 leading-relaxed">Twelve scenes and 65 seconds, composed and rendered programmatically rather than cut in an editor. A frame from scene six.</span>
          </figcaption>
        </figure>

        <figure class="lg:col-span-8 lg:col-start-3" data-reveal="wipe">
          <div class="shot overflow-hidden border border-stone-200">
            <img src="/work/rover-works.webp" alt="The Northline Rover Works prototype: a dark hero reading Specialist care for complex vehicle systems, above a row of illustrated service categories." width="1440" height="1100" loading="lazy" class="w-full h-auto" />
          </div>
          <figcaption class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3">
            <span>
              <span class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500"><span class="h-1.5 w-1.5 rounded-full bg-stone-300"></span>Prototype · workshop website</span>
              <span class="block mt-2 font-serif text-3xl md:text-4xl leading-none tracking-tight">Northline Rover Works</span>
            </span>
            <span class="text-stone-600 leading-relaxed">A complete site for an independent Land Rover specialist: six service categories with original illustrations, a process section and a booking flow that hands off to WhatsApp. Sample content is marked as sample.</span>
          </figcaption>
        </figure>
      </div>

      <ul class="mt-20 border-t border-stone-200">
        {[
          ['Global Service Network map', 'Live on the support site. Service hubs and support centres by region.', 'https://support.mahindraarmored.com'],
          ['Let’s Go design system', 'Colour, type, motion and surface rules for an iOS-first trip app, with tests that enforce them.', '/systems#compose-product'],
          ['Duchè Gebba', 'A fashion storefront prototype with department, group and item navigation.', '/work#more-work'],
          ['MACE ’16 Decennial', 'A live reunion site with a countdown, a poll and a photo archive.', '/work#more-work'],
        ].map(([name, line, href]) => (
          <li class="border-b border-stone-200">
            <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined} class="group grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-1 items-baseline py-5">
              <span class="md:col-span-5 font-serif text-3xl leading-none tracking-tight transition-transform duration-500 group-hover:translate-x-2">{name}</span>
              <span class="md:col-span-6 text-stone-600">{line}</span>
              <svg class="hidden md:block md:col-span-1 justify-self-end text-stone-400 transition-all duration-300 group-hover:text-zapier group-hover:translate-x-0.5 group-hover:-translate-y-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- The site as the specimen -->
    <section class="max-w-7xl mx-auto px-5 md:px-8 py-24 md:py-36">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end mb-12">
        <h2 class="lg:col-span-8 font-serif text-5xl md:text-6xl leading-[0.98] tracking-tight" data-reveal>
          This site is the specimen. <span class="italic text-stone-400">Re-skin it.</span>
        </h2>
        <p class="lg:col-span-4 text-stone-600 leading-relaxed" data-reveal style="--d:120ms">
          Every page reads its colour from one set of tokens. Change the tokens and the whole site follows, case studies included. Your choice is remembered.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" role="group" aria-label="Page skin">
        {skins.map((skin, i) => (
          <button
            type="button"
            data-skin-set={skin.id}
            aria-pressed="false"
            class="skin-card group text-left border border-stone-300 p-6 md:p-8 transition-transform duration-500 hover:-translate-y-1"
            data-reveal
            style={`--d:${i * 100}ms`}
          >
            <span class="flex items-center justify-between">
              <span class="h-14 w-14 rounded-full border border-stone-300 transition-transform duration-700 group-hover:scale-110" style={`background:${skin.swatch}`}></span>
              <span class="skin-state text-xs font-semibold uppercase tracking-[0.2em] text-stone-500"></span>
            </span>
            <span class="block mt-10 font-serif text-5xl leading-none">{skin.name}</span>
            <span class="block mt-3 text-sm text-stone-600">{skinNotes[skin.id]}</span>
          </button>
        ))}
      </div>

      <dl class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-stone-200 pt-10">
        <div>
          <dt class="text-sm text-stone-500">Display</dt>
          <dd class="mt-2 font-serif text-4xl leading-none">Instrument Serif</dd>
        </div>
        <div>
          <dt class="text-sm text-stone-500">Text</dt>
          <dd class="mt-2 text-2xl font-semibold leading-tight">Instrument Sans</dd>
        </div>
        <div>
          <dt class="text-sm text-stone-500">Accent</dt>
          <dd class="mt-2 flex items-center gap-3 font-mono text-lg"><span class="h-6 w-6 rounded-full bg-zapier"></span>#FF4F00</dd>
        </div>
        <div>
          <dt class="text-sm text-stone-500">Shortcut</dt>
          <dd class="mt-2 text-lg">Press <kbd class="font-mono text-sm px-2 py-1 border border-stone-300 rounded">⌘K</kbd> anywhere</dd>
        </div>
      </dl>
    </section>
  </main>
</Layout>

<style>
  .shot img { transition: transform 1.2s var(--ease-out-expo); }
  .shot:hover img { transform: scale(1.03); }
  .skin-card[aria-pressed="true"] { border-color: var(--color-zapier); box-shadow: inset 0 0 0 1px var(--color-zapier); }
  .skin-card .skin-state::after { content: "Apply"; }
  .skin-card[aria-pressed="true"] .skin-state { color: var(--color-zapier); }
  .skin-card[aria-pressed="true"] .skin-state::after { content: "Active"; }
</style>
