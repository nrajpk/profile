---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { nav, contact, skins } from '../data/site.js';
import { projects } from '../data/projects.js';

const {
  title = 'Nikhil Raj PK | Marketing Operations & GTM Systems Builder',
  description = 'Nikhil Raj PK builds practical GTM systems across marketing operations, CRM workflows, analytics, data extraction, automation, API handoffs and AI-assisted workflows.',
  image = '/dp.jpeg',
  chrome = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.nrajpk.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const paletteGroups = [
  {
    name: 'Pages',
    items: [{ label: 'Home', hint: 'Start here', href: '/' }, ...nav.map((n) => ({ label: n.name, hint: n.note, href: n.href }))],
  },
  { name: 'Case studies', items: projects.map((p) => ({ label: p.title, hint: p.tools.join(' · '), href: p.href })) },
  { name: 'Skin', items: skins.map((s) => ({ label: `${s.name} skin`, hint: 'Re-skin the whole site', skin: s.id })) },
  {
    name: 'Contact',
    items: [
      { label: 'Email', hint: contact.email, href: `mailto:${contact.email}`, external: true },
      { label: 'LinkedIn', hint: '/in/nrajpk', href: contact.linkedin, external: true },
    ],
  },
];
---

<!doctype html>
<html lang="en" data-noskin={chrome ? undefined : 'true'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F9F8F6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nikhil Raj PK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@400;700&display=swap"
    />

    <!-- Skin + JS flag, applied before first paint and after every page swap -->
    <script is:inline>
      (function () {
        function applyRoot() {
          var root = document.documentElement;
          root.classList.add('js');
          if (root.hasAttribute('data-noskin')) return;
          var skin = 'paper';
          try { skin = localStorage.getItem('skin') || 'paper'; } catch (e) {}
          root.dataset.skin = skin;
        }
        applyRoot();
        document.addEventListener('astro:after-swap', applyRoot);
      })();
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);
        t.async=1;
        t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xpb00h53mn");
    </script>

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-7L6HKGDH8M"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'G-7L6HKGDH8M');
    </script>

    {chrome && <ClientRouter />}
  </head>

  <body class:list={["font-sans bg-paper text-stone-900 antialiased", !chrome && "dot-grid"]}>
    {chrome && (
      <>
        <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-stone-900 focus:text-white focus:px-4 focus:py-2 focus:rounded-full">Skip to content</a>
        <div class="fixed top-0 left-0 h-[3px] w-full bg-zapier z-[60] origin-left scale-x-0" id="pb" aria-hidden="true"></div>
        <Header />
      </>
    )}

    <slot />

    {chrome && (
      <>
        <Footer />

        <dialog id="palette" aria-label="Jump to" class="palette">
          <div class="palette-box">
            <input id="palette-input" type="text" placeholder="Jump to a page, case study or skin…" autocomplete="off" spellcheck="false" aria-label="Search" />
            <ul id="palette-list">
              {paletteGroups.map((group) => (
                <>
                  <li class="palette-group" data-group>{group.name}</li>
                  {group.items.map((item) => (
                    <li>
                      {item.skin ? (
                        <button type="button" class="palette-item" data-skin-set={item.skin} data-label={item.label.toLowerCase()}>
                          <span>{item.label}</span><small>{item.hint}</small>
                        </button>
                      ) : (
                        <a class="palette-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined} data-label={item.label.toLowerCase()}>
                          <span>{item.label}</span><small>{item.hint}</small>
                        </a>
                      )}
                    </li>
                  ))}
                </>
              ))}
            </ul>
            <p class="palette-foot"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>↵</kbd> open <kbd>esc</kbd> close</p>
          </div>
        </dialog>

        <script>
          import '../scripts/shell.js';
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  .palette { margin: 12vh auto 0; padding: 0; width: min(92vw, 560px); background: transparent; border: 0; color: inherit; }
  .palette::backdrop { background: color-mix(in srgb, var(--color-stone-950) 45%, transparent); backdrop-filter: blur(6px); }
  .palette[open] .palette-box { animation: palette-in 0.45s var(--ease-out-expo); }
  @keyframes palette-in { from { opacity: 0; transform: translateY(-14px) scale(0.98); } }
  .palette-box { background: var(--color-paper); border: 1px solid var(--color-stone-200); border-radius: 18px; overflow: hidden; box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.35); }
  .palette input { width: 100%; padding: 18px 20px; background: transparent; border: 0; border-bottom: 1px solid var(--color-stone-200); font-size: 16px; color: var(--color-stone-900); outline: none; }
  .palette input::placeholder { color: var(--color-stone-500); }
  .palette ul { max-height: 52vh; overflow-y: auto; padding: 8px; }
  .palette-group { padding: 12px 12px 6px; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-stone-500); }
  .palette-item { width: 100%; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 10px 12px; border-radius: 10px; text-align: left; font-size: 14px; font-weight: 500; }
  .palette-item small { font-size: 12px; font-weight: 400; color: var(--color-stone-500); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .palette-item:hover, .palette-item.active { background: var(--color-stone-100); }
  .palette-item.active span { color: var(--color-zapier); }
  .palette-foot { padding: 10px 16px; border-top: 1px solid var(--color-stone-200); font-size: 11px; color: var(--color-stone-500); display: flex; gap: 6px; align-items: center; }
  .palette-foot kbd { font-family: var(--font-mono); font-size: 10px; padding: 1px 5px; border: 1px solid var(--color-stone-300); border-radius: 4px; margin-left: 6px; }
</style>
