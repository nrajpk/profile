---
const tools = [
  'Python',
  'Apify',
  'Salesforce',
  'Zoho',
  'Google Ads',
  'LinkedIn Campaign Manager',
  'Meta Ads',
  'GA4',
  'Google Tag Manager',
  'MS Power BI',
  'MS Clarity',
  'Figma',
  'HTML/CSS',
  'GPT-4o',
  'Midjourney',
  'GitHub',
  'SQL'
];
---

<section id="stack" class="overflow-hidden border-y border-stone-200 bg-white/65 py-8">
  <div class="mb-5 text-center">
    <p class="eyebrow">Supported Stack</p>
  </div>
  <div class="flex w-fit animate-marquee pause-hover">
    <div class="flex items-center gap-14 px-7">
      {tools.map((tool) => (
        <span class="whitespace-nowrap font-mono text-[10px] font-bold uppercase tracking-[0.22em] text-stone-500 transition-colors hover:text-accent">
          {tool}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-14 px-7" aria-hidden="true">
      {tools.map((tool) => (
        <span class="whitespace-nowrap font-mono text-[10px] font-bold uppercase tracking-[0.22em] text-stone-500 transition-colors hover:text-accent">
          {tool}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .pause-hover:hover {
    animation-play-state: paused;
  }
</style>
