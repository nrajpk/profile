---
import Layout from '../layouts/Layout.astro';
import Career from '../components/Career.astro';
import { contact, person } from '../data/site.js';
import { roles, education } from '../data/career.js';

const now = roles[0];
const facts = [
  { k: 'Now', v: `${now.role}, ${now.company}` },
  { k: 'Based in', v: 'UAE, working across global markets' },
  { k: 'Root foundation', v: `${education.degree}, ${education.school}` },
  { k: 'Since', v: `2016 — ${roles.length} roles, one thread` },
];
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>';
---

<Layout
  title={`About — A Marketing Path with a Technical Base | ${person.name}`}
  description={`${person.name}'s background: ${roles.length} roles since 2016 across campaign execution, acquisition, CRM workflows, analytics and data systems, built on a ${education.degree}.`}
>
  <main id="main" class="overflow-x-clip">
    <header class="max-w-7xl mx-auto px-5 md:px-8 pt-32 md:pt-44 pb-20 md:pb-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 relative order-2 lg:order-1">
        <div class="relative max-w-md">
          <div class="absolute -left-4 -bottom-4 md:-left-6 md:-bottom-6 w-2/3 h-2/3 bg-zapier"></div>
          <div class="group relative overflow-hidden bg-stone-200">
            <img
              src="/photos/portrait-steps.webp"
              alt={`${person.name} sitting on stone steps outdoors, hands clasped`}
              width="1086"
              height="1448"
              fetchpriority="high"
              class="portrait w-full aspect-[4/5] object-cover object-[50%_20%] grayscale contrast-[1.08] group-hover:grayscale-0 scale-105 group-hover:scale-100 transition-all duration-1000 ease-out"
            />
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 order-1 lg:order-2">
        <span class="kicker mb-8">Background</span>
        <h1 class="display">
          A marketing path <span class="italic text-quiet">with a technical base.</span>
        </h1>
        <p class="mt-8 text-lg text-stone-600 leading-relaxed max-w-xl">
          My career has moved through campaign execution, websites, acquisition, CRM workflows, analytics, and data systems. The common thread is operational: making the visible parts of marketing work through cleaner systems underneath.
        </p>
        <p class="mt-5 text-stone-600 leading-relaxed max-w-xl">
          Most growth engineers spent their careers in code and picked up marketing along the way. I spent ten years in marketing, on top of a computer science degree, and now build the systems it runs on.
        </p>

        <dl class="mt-12 border-t border-stone-200">
          {facts.map((f) => (
            <div class="grid grid-cols-[7.5rem_1fr] md:grid-cols-[10rem_1fr] gap-4 py-4 border-b border-stone-200">
              <dt class="text-sm text-stone-600">{f.k}</dt>
              <dd class="text-sm font-medium">{f.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
          <a href="/cv" class="link-arrow">One-page CV <Fragment set:html={arrow} /></a>
          <a href={contact.linkedin} target="_blank" rel="noreferrer" class="link-arrow">LinkedIn <Fragment set:html={arrow} /></a>
          <a href={`mailto:${contact.email}`} class="link-arrow">{contact.email} <Fragment set:html={arrow} /></a>
          <button type="button" data-copy={contact.email} class="link-arrow"><span data-copy-label aria-live="polite">Copy address</span></button>
        </div>
      </div>
    </header>

    <section class="max-w-7xl mx-auto px-5 md:px-8 pb-12 md:pb-20" aria-labelledby="career-heading">
      <h2 id="career-heading" class="font-serif text-4xl md:text-6xl leading-[0.98] tracking-tight max-w-3xl mb-10 md:mb-14">
        {roles.length === 4 ? 'Four' : roles.length} roles since 2016. <span class="italic text-quiet">The latest one first.</span>
      </h2>
      <Career />
    </section>
  </main>
</Layout>

<style>
  /* Touch screens can't hover, so they get the colour version outright. */
  @media (hover: none) {
    .portrait { filter: none; scale: none; }
  }
</style>
