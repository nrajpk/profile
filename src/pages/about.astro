---
import Layout from '../layouts/Layout.astro';
import CareerArchitecture from '../components/CareerArchitecture.jsx';
import { contact } from '../data/site.js';

const facts = [
  { k: 'Now', v: 'Marketing & Digital Transformation at a defense manufacturer' },
  { k: 'Based in', v: 'UAE, working across global markets' },
  { k: 'Root foundation', v: 'B.Tech in Computer Science, Mar Athanasius College of Engineering' },
  { k: 'Since', v: '2016 — four roles, one thread' },
];
---

<Layout
  title="About — A Marketing Path with a Technical Base | Nikhil Raj PK"
  description="Nikhil Raj PK's background: four roles since 2016 across campaign execution, acquisition, CRM workflows, analytics and data systems, built on a B.Tech in Computer Science."
>
  <main id="main" class="overflow-x-clip">
    <header class="max-w-7xl mx-auto px-5 md:px-8 pt-32 md:pt-44 pb-20 md:pb-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 relative order-2 lg:order-1">
        <div class="relative max-w-md">
          <div class="absolute -left-4 -bottom-4 md:-left-6 md:-bottom-6 w-2/3 h-2/3 bg-zapier" data-reveal="wipe"></div>
          <div class="group relative overflow-hidden bg-stone-200" data-reveal="wipe" style="--d:150ms">
            <img
              src="/portrait.webp"
              alt="Portrait of Nikhil Raj PK"
              width="800"
              height="800"
              class="w-full aspect-[4/5] object-cover grayscale contrast-[1.08] group-hover:grayscale-0 scale-105 group-hover:scale-100 transition-all duration-1000 ease-out"
            />
          </div>
        </div>
        <p class="mt-10 text-sm text-stone-500">Hover the portrait. It was shot in colour.</p>
      </div>

      <div class="lg:col-span-7 order-1 lg:order-2">
        <span class="kicker mb-8">Background</span>
        <h1 class="display" data-reveal="wipe">
          A marketing path <span class="italic text-stone-400">with a technical base.</span>
        </h1>
        <p class="mt-8 text-lg text-stone-600 leading-relaxed max-w-xl" data-reveal style="--d:120ms">
          My career has moved through campaign execution, websites, acquisition, CRM workflows, analytics, and data systems. The common thread is operational: making the visible parts of marketing work through cleaner systems underneath.
        </p>
        <p class="mt-5 text-stone-600 leading-relaxed max-w-xl" data-reveal style="--d:180ms">
          Most growth engineers started with code and are learning marketing. I went the other way — B.Tech in Computer Science, ten years of marketing judgment, now building the systems growth actually runs on.
        </p>

        <dl class="mt-12 border-t border-stone-200">
          {facts.map((f, i) => (
            <div class="grid grid-cols-[7.5rem_1fr] md:grid-cols-[10rem_1fr] gap-4 py-4 border-b border-stone-200" data-reveal style={`--d:${200 + i * 70}ms`}>
              <dt class="text-sm text-stone-500">{f.k}</dt>
              <dd class="text-sm font-medium">{f.v}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
          <a href={contact.linkedin} target="_blank" rel="noreferrer" class="link-arrow">
            LinkedIn
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
          <a href={`mailto:${contact.email}`} class="link-arrow">
            {contact.email}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </div>
    </header>

    <section class="max-w-7xl mx-auto px-5 md:px-8 border-t border-stone-200 pt-16 md:pt-20">
      <h2 class="font-serif text-4xl md:text-6xl leading-[0.98] tracking-tight max-w-3xl" data-reveal>
        Four roles. <span class="italic text-stone-400">Scroll through them.</span>
      </h2>
    </section>

    <CareerArchitecture client:load />
  </main>
</Layout>
