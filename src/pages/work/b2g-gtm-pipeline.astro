---
import CaseStudy from '../../components/CaseStudy.astro';

// LIVE TELEMETRY — pulled from production tooling on 20 Jul 2026.
// Update these by re-querying n8n + Instantly. Do not invent values.
const telemetry = {
  pulledOn: 'July 20, 2026',
  executionsTotal: 79,
  recentSampleSize: 50,
  recentSuccessRate: '100%',
  activeWorkflows: 3,
  emailsSent: 21,
  positiveReplies: 1,
  opportunities: 1,
  bounces: 1,
  dailyCap: 15,
};

const decisions = [
  {
    n: '01',
    title: 'A human approval console sits between AI and send',
    what: 'Qualified leads land in an Airtable review queue. Nothing is contacted until a person clicks approve; the click fires an event-driven POST that pushes the lead to the sending platform.',
    whyNot: 'Full automation was the obvious build. In defense-adjacent B2G, one badly-targeted email to a government contact costs more than a week of manual review saves. Judgment stays where it matters; automation handles everything around it.',
  },
  {
    n: '02',
    title: 'Open tracking is switched off — on purpose',
    what: 'The live campaign config has open_tracking and link_tracking disabled. Reported opens on this system are zero, and that is correct.',
    whyNot: 'Tracking pixels and rewritten links raise spam-filter risk and inflate dashboards with unreliable data. For a low-volume, high-consideration pipeline, the only metrics that matter are replies and opportunities — so those are the only ones measured.',
  },
  {
    n: '03',
    title: 'Volume is capped, plain-text first, stop-on-reply',
    what: 'Daily send cap of 10–15, first email is text-only, sending restricted to UAE business hours (Sun–Thu), and the sequence halts the moment a lead replies.',
    whyNot: 'A 100/day blast would produce bigger vanity numbers and a burned domain. Sender reputation is the pipeline\'s scarcest asset; every config choice protects it.',
  },
  {
    n: '04',
    title: 'Event-driven, not polling',
    what: 'The approval console POSTs directly to a webhook on click. No scheduler loops asking "anything new?" every minute.',
    whyNot: 'Polling wastes executions, adds latency, and creates race conditions on double-approval. The event model means the recent execution log reads as a clean list of sub-second successful runs.',
  },
  {
    n: '05',
    title: 'Guardrails before AI, validation before guardrails',
    what: 'Extraction runs through field validation and rate-limit-aware guardrails before any AI qualification step. Batch continuation uses a search-signature so re-runs never re-process the same segment.',
    whyNot: 'LLMs applied to dirty data produce confident garbage. Cleaning first means the qualification layer scores real records — and the dedup signature keeps API spend flat as the pipeline scales.',
  },
  {
    n: '06',
    title: 'Two sending platforms, one reporting endpoint',
    what: 'A read-only n8n workflow fetches live campaign analytics and mailbox health from both sending platforms and merges them into a single JSON response for the ops console.',
    whyNot: 'Two dashboards means two versions of the truth. One merged, read-only endpoint (no AI calls, no write access) gives management a single view without another SaaS subscription.',
  },
];

const pipeline = [
  'Campaign config submitted from ops console',
  'Prospect search via data provider API',
  'Field validation + combined mapping',
  'Extraction guardrails (rate limits, retries)',
  'AI qualification against ICP rules',
  'Airtable review queue — human approval',
  'Event-driven push to sending platform',
  'Sequenced outreach, stop-on-reply',
  'Merged live reporting endpoint',
];
---

<CaseStudy
  slug="b2g-gtm-pipeline"
  title="B2G GTM Pipeline — System Breakdown | Nikhil Raj PK"
  description="Full decision-level breakdown of a live B2G lead generation pipeline: AI qualification, human-in-the-loop approval, deliverability-first sending, and merged reporting. Real production telemetry."
  headline="A B2G outbound pipeline where automation does the work and"
  headlineQuiet="judgment does the deciding."
  lede="Built for long-cycle armoured vehicle sales into government and defense-adjacent markets — an environment where one careless email costs more than a hundred good ones earn. Every design decision below follows from that constraint."
  figures={{
    label: 'Production telemetry',
    asOf: `Queried from live tooling, ${telemetry.pulledOn}`,
    items: [
      { value: telemetry.executionsTotal, label: 'Workflow executions' },
      { value: telemetry.recentSuccessRate, label: `Success rate, last ${telemetry.recentSampleSize} runs` },
      { value: `${telemetry.emailsSent} → ${telemetry.positiveReplies}`, label: 'First emails → positive replies' },
      { value: telemetry.opportunities, label: 'Opportunity created' },
    ],
    note: `These are real figures from a deliberately low-volume launch phase: ${telemetry.dailyCap}/day cap, ${telemetry.bounces} bounce, open tracking disabled by design (see Decision 02). Small numbers, honestly reported — the system is built to scale volume only after deliverability is proven.`,
  }}
  problem="Sourcing B2G prospects meant hours of manual research per batch, inconsistent record quality, and no clean handoff between research, qualification, and outreach. Sales attention was going into copy-paste work instead of conversations."
  constraint="Defense-adjacent outreach cannot tolerate spray-and-pray. Wrong targets, burned domains, or sloppy personalization carry reputational cost far beyond marketing. The system had to be fast <em>and</em> conservative — which is exactly the tension the architecture resolves."
  sequence={{ title: 'The pipeline.', steps: pipeline }}
  decisionsTitle="Six decisions that define the system."
  decisionsIntro="Anyone can wire APIs together. The system is the set of choices about what <em>not</em> to automate, what not to track, and what not to send."
  decisions={decisions}
  stack={['n8n', 'Apollo API', 'Apify', 'Airtable', 'Instantly', 'Smartlead', 'Claude / LLM APIs', 'Webhooks / REST']}
  disclosure={`Telemetry figures were queried directly from the production workflow engine and sending platform on ${telemetry.pulledOn}. Prospect data, recipient identities, campaign contents, and client-specific details are omitted. Figures reflect an early controlled-volume phase and are reported as-is, without extrapolation.`}
  walkthrough="I can walk through the workflow architecture, the qualification prompt design, and the deliverability setup live — with the actual system on screen."
/>
