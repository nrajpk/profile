---
const tools = [
  'Python', 'Apify', 'Salesforce', 'Zoho', 'Custom CRM', 'GA4', 'Google Tag Manager',
  'Google Ads', 'LinkedIn Campaign Manager', 'Meta Ads', 'MS Power BI', 'MS Clarity',
  'Figma', 'HTML/CSS', 'GPT-4o', 'Midjourney', 'GitHub', 'SQL'
];
---

<div class="py-12 border-y border-stone-100 bg-white/35 overflow-hidden group">
  <div class="flex w-fit animate-marquee pause-hover">
    <div class="flex items-center gap-16 px-8">
      {tools.map((tool) => (
        <span class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 hover:text-zapier transition-colors cursor-default whitespace-nowrap">
          {tool}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-16 px-8" aria-hidden="true">
      {tools.map((tool) => (
        <span class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 hover:text-zapier transition-colors cursor-default whitespace-nowrap">
          {tool}
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .pause-hover:hover {
    animation-play-state: paused;
  }
</style>
