---
// Compact identity strip — the 5-second "who is this" answer.
const nodes = [
  {
    period: '2016–2021',
    label: 'Marketing Foundations',
    detail: 'Campaigns, landing pages, creative ops',
  },
  {
    period: '2022–2023',
    label: 'Acquisition & Analytics',
    detail: 'Google Ads, GA4, tracking architecture',
  },
  {
    period: '2023–Now',
    label: 'Growth Engineering',
    detail: 'Data pipelines, AI qualification, human-in-loop outbound — live in production',
  },
];
---

<section id="who" class="px-6 py-16 border-y border-stone-100 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

      <div class="lg:col-span-4">
        <span class="font-mono text-[10px] font-bold text-zapier uppercase tracking-[0.35em] mb-4 block">Who am I</span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-stone-900 leading-snug">
          A decade of marketing,
          <span class="font-serif italic font-normal text-stone-400">rebuilt on an engineering base.</span>
        </h2>
        <p class="text-stone-500 text-sm leading-relaxed mt-4 max-w-sm">
          Most growth engineers started with code and are learning marketing. I went the other way — B.Tech in Computer Science, ten years of marketing judgment, now building the systems growth actually runs on.
        </p>
      </div>

      <div class="lg:col-span-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 relative">
          <div class="hidden sm:block absolute top-7 left-[12%] right-[12%] h-px bg-stone-200"></div>
          {nodes.map((node, i) => (
            <div class="relative bg-paper border border-stone-200 rounded-2xl p-5 hover:border-zapier/40 transition-colors">
              <div class={`h-2.5 w-2.5 rounded-full mb-4 ${i === nodes.length - 1 ? 'bg-zapier' : 'bg-stone-300'}`}></div>
              <p class="font-mono text-[9px] font-bold uppercase tracking-[0.25em] text-stone-400 mb-2">{node.period}</p>
              <p class="font-bold text-stone-900 leading-tight mb-1.5">{node.label}</p>
              <p class="text-xs text-stone-500 leading-relaxed">{node.detail}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
