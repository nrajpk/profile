---
import '../styles/global.css';

const {
  title = 'Nikhil Raj PK | Marketing Operations & GTM Systems Builder',
  description = 'Computer Science backed marketing operations builder working across CRM systems, analytics, automation, lead generation, and AI assisted GTM workflows.'
} = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f4ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="dot-grid bg-paper text-stone-950 antialiased selection:bg-accent-soft selection:text-accent">
    <slot />
  </body>
</html>
